# Prisma CLI memakai SQLite lokal hanya untuk membuat migration SQL.
DATABASE_URL="file:./dev.db"
TURSO_DATABASE_URL="libsql://nama-database-nama-akun.aws-ap-northeast-1.turso.io"
TURSO_AUTH_TOKEN="ganti-dengan-token-baru-dari-turso"
AUTH_SECRET="ganti-dengan-random-secret-minimal-32-karakter"
NEXT_PUBLIC_APP_VERSION="0.1.0-mvp"
UPLOAD_DIR="./uploads"
DEMO_ADMIN_PASSWORD="buat-password-admin-development"
DEMO_BORROWER_PASSWORD="buat-password-peminjam-development"
DEMO_APPROVER_PASSWORD="buat-password-sekda-development"
DEMO_ADMIN_EMAIL="admin@sipinter.go.id"
DEMO_BORROWER_EMAIL="pegawai@sipinter.go.id"
DEMO_APPROVER_EMAIL="sekda@sipinter.go.id"
